<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 背景图片 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/beijing"
        android:scaleType="centerCrop"/>

    <!-- 半透明白色遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#C0FFFFFF"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 返回按钮 -->
            <TextView
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="←"
                android:textSize="24sp"
                android:textColor="#333"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp"/>

            <!-- 菜品名称 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#16E9C6"
                    android:padding="20dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_dish_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="菜品名称"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 制作方法 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="20dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="制作方法"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:layout_marginBottom="10dp"/>
                    <TextView
                        android:id="@+id/tv_cooking_method"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="制作方法详情"
                        android:textSize="16sp"
                        android:textColor="#666"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 营养信息 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="20dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="营养信息"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:layout_marginBottom="10dp"/>
                    <TextView
                        android:id="@+id/tv_calories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="热量：未知"
                        android:textSize="16sp"
                        android:textColor="#666"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/tv_protein"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="蛋白质：未知"
                        android:textSize="16sp"
                        android:textColor="#666"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/tv_fiber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="纤维：未知"
                        android:textSize="16sp"
                        android:textColor="#666"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/tv_sodium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="钠：未知"
                        android:textSize="16sp"
                        android:textColor="#666"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/tv_nutrition_highlight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="营养亮点"
                        android:textSize="16sp"
                        android:textColor="#FF6B35"
                        android:textStyle="italic"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 烹饪信息 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="20dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="烹饪信息"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:layout_marginBottom="10dp"/>
                    <TextView
                        android:id="@+id/tv_difficulty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="难度：未知"
                        android:textSize="16sp"
                        android:textColor="#666"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/tv_cooking_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="烹饪时间：未知"
                        android:textSize="16sp"
                        android:textColor="#666"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
