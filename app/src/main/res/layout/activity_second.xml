<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 背景图片 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/beijing"
        android:scaleType="centerCrop"/>

    <!-- 半透明白色遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#C0FFFFFF"/>

    <!-- 原有内容 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <!-- 新页面标题（原有） -->
        <TextView
            android:id="@+id/tv_second_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="菜品卡路里查询"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="50dp"/>

        <!-- 选图片按钮（原有） -->
        <Button
            android:id="@+id/btn_choose_photo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="选择菜品图片"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/tv_second_title"
            android:layout_marginTop="80dp"/>

        <!-- 图片显示控件（原有） -->
        <ImageView
            android:id="@+id/iv_food"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="30dp"
            android:background="#f5f5f5"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toBottomOf="@id/btn_choose_photo"/>

        <!-- 新增：卡路里结果显示区域 -->
        <TextView
            android:id="@+id/tv_calorie_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="识别结果：未查询"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:padding="10dp"
            android:background="#f8f8f8"
            app:layout_constraintTop_toBottomOf="@id/iv_food"/>

        <!-- 加载提示（新增，可选） -->
        <TextView
            android:id="@+id/tv_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="正在查询卡路里..."
            android:textSize="14sp"
            android:textColor="#666"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_calorie_result"/>

        <!-- 返回按钮（原有） -->
        <TextView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="←"
            android:textSize="22sp"
            android:textColor="#333"
            android:gravity="center"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>