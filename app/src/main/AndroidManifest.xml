<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 新增：声明读取外部存储的权限（用于打开相册） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" /> <!-- 兼容旧版本安卓（API 32及以下） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" /> <!-- 新增：网络权限（必须加，否则发不了请求给后端） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_background"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Base.Theme.Food_project"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".TodayIntakeActivity"
            android:exported="false" />
        <activity
            android:name=".HealthManagementActivity"
            android:exported="false" />
        <activity
            android:name=".FoodRecommendActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".FoodAnalysisActivity"
            android:exported="false" />
        <activity
            android:name=".MenuRecognitionActivity"
            android:exported="false" />
        <activity
            android:name=".DishRecognitionActivity"
            android:exported="false" /> <!-- 保留原有Activity -->
        <activity
            android:name=".SecondActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

    </application>

</manifest>